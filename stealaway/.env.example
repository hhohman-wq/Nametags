# Stealaway configuration. The app reads plain environment variables (no .env
# loader — export these in your shell, or run:  env $(cat .env | xargs) npm start
# after copying this file to .env).

# --- Server ---
PORT=4600
# STEALAWAY_DB=stealaway.db            # sqlite path; ':memory:' works
# STEALAWAY_POLL_MS=60000             # fare polling interval
# STEALAWAY_PUBLIC_URL=https://...    # public origin, used in Stripe redirect URLs
# STEALAWAY_ADMIN_KEY=change-me       # protects /admin and /api/admin/stats (?key=...)

# --- Fare providers (add any; with none set, the mock provider runs) ---
# Duffel (https://app.duffel.com) — self-serve flight search + booking.
# A test key (duffel_test_...) returns realistic offers at no cost.
# DUFFEL_API_KEY=duffel_test_xxx

# Travelpayouts / Aviasales Data API (https://app.travelpayouts.com) —
# cached real fares, broad coverage. Free token from the dashboard.
# TRAVELPAYOUTS_TOKEN=xxx

# STEALAWAY_USE_MOCK=1                # keep the mock running alongside real providers
# STEALAWAY_SEED=42                   # mock RNG seed

# --- Revenue: affiliate ---
# Your Travelpayouts affiliate marker. When set, Book clicks redirect to
# Aviasales tagged with it (flights pay ~1.1–2.2% of ticket value) and the
# revenue dashboard estimates commissions per click.
# TRAVELPAYOUTS_MARKER=123456
# STEALAWAY_COMMISSION_RATE=0.016       # blended flight estimate used by the dashboard
# STEALAWAY_HOTEL_COMMISSION_RATE=0.04  # blended hotel estimate ("Find a stay" clicks via Hotellook)

# --- Revenue: Stealaway Pro ($49/yr via Stripe Checkout) ---
# Without these, "Upgrade" grants Pro instantly in dev mode.
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_PRICE_ID=price_xxx          # a $49/yr recurring price
# STRIPE_WEBHOOK_SECRET=whsec_xxx    # for POST /api/billing/webhook
